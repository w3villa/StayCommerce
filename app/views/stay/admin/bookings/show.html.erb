<div class="container mx-auto p-4">
  <div class="row mb-0 pb-0">
    <h1 class="px-8"> <%= @booking.number %></h1>
  </div>

  <div class="row me-0 mt-4">
    <div class="col-md-12 d-flex">
      <div class="col-md-8">
        <% if @booking.line_items.exists? %>
          <div class="card mb-3">
            <div class="card-header">
              <h5 class="card-title mb-0 h6">Booking Details</h5>
            </div>
            <div class="table-responsive border-0 rounded bg-white">
              <table class="table line-items" data-hook="line-items">
                <thead class="text-muted">
                  <tr>
                    <th class="text-center">Image</th>
                    <th class="text-center">Property Name</th>
                    <th class="text-center">Price</th>
                  </tr>
                </thead>
                <tbody>
                  <% @booking.line_items.each do |line_item| %>
                    <tr class="line-item" id="line-item-<%= line_item.id %>">
                      <td class="line-item-image image text-center">
                        <%= image_tag main_app.url_for(line_item.room.room_images.first), size: "25x25" if line_item.room.room_images.attached? %>
                      </td>
                      <td class="line-item-price text-center"><%= line_item.room.property.title %></td>
                      <td class="line-item-price text-center"><%= line_item.room.price %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>

        <div class="card mb-3">
          <div class="card-header">
            <h5 class="card-title mb-0 h6">User Details</h5>
          </div>
          <div class="table-responsive border-0 rounded bg-white">
            <table class="table line-items" data-hook="line-items">
              <thead class="text-muted">
                <tr>
                  <th class="text-center">Name</th>
                  <th class="text-center">Email</th>
                  <th class="text-center">Phone</th>
                  <th class="text-center">Gender</th>
                  <th class="text-center">Date of Birth</th>
                </tr>
              </thead>
              <tbody>
                <tr class="line-item">
                  <td class="line-item-price text-center"><%= @booking.user.name %></td>
                  <td class="line-item-price text-center"><%= @booking.user.email %></td>
                  <td class="line-item-qty-show text-center">
                    <%= @booking.user.phone %>
                  </td>
                  <td class="line-item-qty-show text-center">
                    <%= @booking.user.gender %>
                  </td>
                  <td class="line-item-qty-show text-center">
                    <%= @booking.user.date_of_birth %>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-md-3 ms-4">
        <%= render 'stay/admin/bookings/booking_invoice' %>
        <%= render 'stay/admin/bookings/booking_summary' %>
      </div>
    </div>
  </div>
</div>