<div class="container mx-auto p-4">
  <div class="row mt-4 justify-content-center">
    <div class="col-md-8 col-lg-10">
      <div class="card">
        <div class="card-header">
          <h2 class="text-xl font-semibold mb-0">Property Details</h2>
        </div>
        <div class="card-body">
          <div class="step-description">
            <h3 class="font-semibold mb-3">Description</h3>
            <div class="row">
                <p class="form-label"><strong>Title:</strong><span class="property-data"><%= @property.title %></span></p>
                <p class="form-label"><strong>Description:</strong><span class="property-data"><%= @property.description%></span></p>
                <p class="form-label"><strong>category:</strong><span class="property-data"><%= @property.property_category&.name %></span></p>
                <p class="form-label"><strong>Property Type:</strong><span class="property-data"><%= @property.property_type&.name %></span></p>
                <p class="form-label"><strong>city:</strong><span class="property-data"><%= @property.city %></span></p>
                <p class="form-label"><strong>address:</strong><span class="property-data"><%= @property.address %></span></p>
                <p class="form-label"><strong>guest_no.:</strong><span class="property-data"><%= @property.guest_number%></span></p>
                <p class="form-label"><strong>country:</strong><span class="property-data"><%= @property.country %></span></p>
                <p class="form-label"><strong>active: </strong><input type="checkbox" class="form-check-input" <%= @property.active ? 'checked' : '' %> disabled></p>
            </div>
          </div>
          <hr>
          <hr>
          <!-- Images Step -->
          <div class="step-images mt-5">
            <h3 class="font-semibold mb-3">Images</h3>
            <p class="form-label"><strong>Cover Image: </strong>
              <span><%= image_tag main_app.url_for(@property.cover_image), size: "60x60" if @property.cover_image.attached? %></span>
            </p>
          </div>
          <hr>
          <!-- Details Step -->
          <div class="step-details mt-5">
            <h3 class="font-semibold mb-3">Details</h3>
            <div class="row">
              <p class="form-label"><strong>Property Size:</strong><span class="property-data"><%= @property.property_size %></span></p>
              <div class="field">
                <p class="form-label"><strong>Additional Rules:</strong></p>
                <% if @property.additional_rules.present? %>
                    <% @property.additional_rules.each do |rule| %>
                      <span class="property-data"><%= rule.name %></span>
                    <% end %>
               <% else %>
                  <p class="property-data">No additional rules specified.</p>
                <% end %>
              </div>
            </div>
          </div>
          <hr>
          <!-- Location Step -->
          <div class="step-location mt-5">
            <h3 class="font-semibold mb-3">Location</h3>
            <div class="row">
              <p class="form-label"><strong>Address:</strong><span class="property-data"><%= @property.address %></span></p>
              <p class="form-label"><strong>City:</strong><span class="property-data"><%= @property.city %></span></p>
              <p class="form-label"><strong>State:</strong><span class="property-data"><%= @property.state %></span></p>
              <p class="form-label"><strong>Country:</strong><span class="property-data"><%= @property.country %></span></p>
            </div>
          </div>
          <hr>
          <!-- Actions -->
          <div class="d-flex mt-4 p-4 justify-content-center">
            <%= button_to 'Approve', approve_admin_property_path(@property), method: :put,  class: 'btn btn-warning me-3',disabled: @property.approved? || @property.rejected? %>
            <%= button_to 'Reject', reject_admin_property_path(@property), method: :put, class: 'btn btn-secondary', disabled: @property.approved? || @property.rejected? %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
