<%= form_with(model: [:admin, property], local: true) do |f| %>
  <% if property.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(property.errors.count, "error") %> prohibited this property from being saved:</h2>
      <ul>
        <% property.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6">
      <div class="field">
        <%= f.label :cover_image, "Cover Image", class: "form-label" %>
        <%= f.file_field :cover_image, class: "form-control" %>
        <%= image_tag main_app.url_for(property.cover_image), size: "100x100", class: "mt-2" if property.cover_image.attached? %>
        <%= f.hidden_field :cover_image_cache, value: property.cover_image %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="field">
        <%= f.label :place_images, "Place Images", class: "form-label" %>
        <%= f.file_field :place_images, class: "form-control", multiple: true %>
        <% if property.place_images.attached? %>
          <div>
            <% property.place_images.each do |image| %>
              <%= image_tag main_app.url_for(image), size: "100x100", class: "mt-2" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div class="form-group mt-4">
        <%= hidden_field_tag :step, 'images' %>
        <%= f.submit 'Continue', class: 'btn btn-primary' %>
      </div>
    </div>
  </div>
<% end %>
